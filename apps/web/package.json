{
  "name": "@trading/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "format": "prettier --write --ignore-path ../../.prettierignore \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,cjs,mjs,json}\"",
    "format:all": "npm run lint:fix && npm run format",
    "typecheck": "tsc -b --noEmit",
    "test": "jest --runInBand --watch=false",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@babel/core": "8.0.7",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-react": "8.0.1",
    "@babel/preset-typescript": "8.0.7",
    "@eslint-react/eslint-plugin": "5.28.1",
    "@eslint/js": "^10.0.1",
    "@jest/globals": "30.5.2",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "30.5.2",
    "eslint": "^10.10.0",
    "eslint-plugin-jsx-a11y-x": "0.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  }
}
