# Copy to .env and fill locally. Never commit or share the resulting private file.
# Generate each administrator password independently as exactly 64 hexadecimal characters.
DEV_DB_ADMIN_PASSWORD=
TEST_DB_ADMIN_PASSWORD=
# Use separate, nonempty application passwords. These are raw passwords, not URL-encoded.
DEV_DB_PASSWORD=
TEST_DB_PASSWORD=

# Encode only the password component of each URL; Compose tests use the test service DNS.
# Development and shadow use the same development application password.
DEV_DATABASE_URL=postgresql://trading_dev:REPLACE_WITH_PERCENT_ENCODED_DEV_PASSWORD@127.0.0.1:5554/trading_dev
DEV_SHADOW_DATABASE_URL=postgresql://trading_dev:REPLACE_WITH_PERCENT_ENCODED_DEV_PASSWORD@127.0.0.1:5554/trading_shadow
# Root Compose runs db-tests on its test-only network. Native tests use loopback 5556 instead.
TEST_DATABASE_URL=postgresql://trading_test:REPLACE_WITH_PERCENT_ENCODED_TEST_PASSWORD@db-test:5432/trading_test
